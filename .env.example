# FitMate Email SMTP Configuration (สำหรับส่ง OTP จริงเข้า Gmail / อีเมล)
# หากใช้ Gmail ให้เปิด 2-Step Verification และสร้าง App Password (รหัสผ่านสำหรับแอป 16 หลัก)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM=FitMate <your_email@gmail.com>
